# ============================================
# Pipedrive
# ============================================
# Seu API Token do Pipedrive (Configurações > Preferências pessoais > API)
PIPEDRIVE_API_TOKEN=seu_token_aqui

# Apenas o SUBDOMÍNIO da sua empresa, sem https:// e sem .pipedrive.com
# Se a sua URL é https://suaempresa.pipedrive.com, use: suaempresa
PIPEDRIVE_COMPANY_DOMAIN=suaempresa

# ============================================
# Servidor
# ============================================
PORT=3000

# ============================================
# Campos Personalizados - Hash Keys
# ============================================
# Organizações e Negócios têm hashes DIFERENTES para o mesmo campo.
# Execute "npm run setup-fields" para descobrir os seus e cole abaixo.
# Deixe em branco os campos que você não usa — eles são simplesmente ignorados.

# ──── ORGANIZAÇÃO ────
ORG_CNPJ_FIELD_KEY=
ORG_RAZAO_SOCIAL_FIELD_KEY=
ORG_NOME_FANTASIA_FIELD_KEY=
ORG_LOGRADOURO_FIELD_KEY=
ORG_NUMERO_FIELD_KEY=
ORG_COMPLEMENTO_FIELD_KEY=
ORG_BAIRRO_FIELD_KEY=
ORG_CIDADE_FIELD_KEY=
ORG_UF_FIELD_KEY=
ORG_CEP_FIELD_KEY=
ORG_TELEFONE_FIELD_KEY=
ORG_EMAIL_FIELD_KEY=
ORG_NATUREZA_JURIDICA_FIELD_KEY=
ORG_CAPITAL_SOCIAL_FIELD_KEY=

# ──── NEGÓCIO (DEAL) ────
DEAL_CNPJ_FIELD_KEY=
DEAL_RAZAO_SOCIAL_FIELD_KEY=
DEAL_NOME_FANTASIA_FIELD_KEY=
DEAL_LOGRADOURO_FIELD_KEY=
DEAL_NUMERO_FIELD_KEY=
DEAL_COMPLEMENTO_FIELD_KEY=
DEAL_BAIRRO_FIELD_KEY=
DEAL_CIDADE_FIELD_KEY=
DEAL_UF_FIELD_KEY=
DEAL_CEP_FIELD_KEY=
DEAL_TELEFONE_FIELD_KEY=
DEAL_EMAIL_FIELD_KEY=
DEAL_NATUREZA_JURIDICA_FIELD_KEY=
DEAL_CAPITAL_SOCIAL_FIELD_KEY=
